---
// The header's title: the wordmark links to the marketing site, "docs" to the docs root. Starlight's
// default links the title to the docs root only; readers arriving from turf.build expect the wordmark
// to take them back.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<span class="turf-sitetitle">
  <a class="wordmark" href="https://turf.build/"><span class="mark">+</span>turf<span class="tld">.build</span></a>
  <a class="docs" href={base}>docs</a>
</span>
