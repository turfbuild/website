---
// What runs where in the turf-kagent example: Figure 1 of *Agentic IaC for Platform Teams*,
// as the website's components/figures/KagentFigure.astro carries it (same geometry; change both).
// Tokens only (docs.css, "figures"); markers are local to this svg.
interface Props { caption?: string }
const { caption } = Astro.props;
---

<figure class="docfig">
  <svg class="fig" viewBox="0 0 672 418" role="img" aria-label="What runs where. Inside your cluster, the control plane: kagent 1.0, with its UI (the chat, and Approve or Reject) and the agent, which runs in a sandbox and holds no credentials; and Turf, with its MCP server (plan, show and apply as the agent's tools; tfstate in a Secret per stack) and its engine, which runs the providers on pods that start from zero and holds the cloud credentials. A person asks in the kagent UI (1); the agent plans through Turf's MCP server (2); the person approves in the kagent UI (3); the engine applies, with the credentials (4), to what is outside the cluster: cloud resources (two AWS Lambda functions in the example), Kubernetes clusters (EKS, GKE, AKS or bare metal, and their addons), and anything with a provider. The agent then fetches the public URLs of what it built, with no credentials (5).">
    <defs>
      <marker id="kg-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="f-stroke"/></marker>
      <marker id="kg-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="f-ok"/></marker>
      <marker id="kg-inh" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="f-inh"/></marker>
    </defs>
    <text x="124" y="10" class="t-cap">YOUR CLUSTER · THE CONTROL PLANE</text>
    <circle cx="404" cy="7" r="6" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="404" y="10.1" text-anchor="middle" class="t-m7" style="font-size:7.2px; font-weight:700; fill:var(--panel)">1</text>
    <text x="414" y="10.5" class="t-mono" style="font-size:8.8px; fill:var(--ink)">ask</text>
    <circle cx="450" cy="7" r="6" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="450" y="10.1" text-anchor="middle" class="t-m7" style="font-size:7.2px; font-weight:700; fill:var(--panel)">2</text>
    <text x="460" y="10.5" class="t-mono" style="font-size:8.8px; fill:var(--ink)">plan</text>
    <circle cx="502" cy="7" r="6" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="502" y="10.1" text-anchor="middle" class="t-m7" style="font-size:7.2px; font-weight:700; fill:var(--panel)">3</text>
    <text x="512" y="10.5" class="t-mono" style="font-size:8.8px; fill:var(--ink)">approve</text>
    <circle cx="572" cy="7" r="6" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="572" y="10.1" text-anchor="middle" class="t-m7" style="font-size:7.2px; font-weight:700; fill:var(--panel)">4</text>
    <text x="582" y="10.5" class="t-mono" style="font-size:8.8px; fill:var(--ink)">apply</text>
    <circle cx="630" cy="7" r="6" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="630" y="10.1" text-anchor="middle" class="t-m7" style="font-size:7.2px; font-weight:700; fill:var(--panel)">5</text>
    <text x="640" y="10.5" class="t-mono" style="font-size:8.8px; fill:var(--ink)">check</text>
    <rect class="f-none s-faint" x="112.5" y="20.5" width="559" height="262" rx="14" stroke-dasharray="2 3"/>
    <rect class="f-panel2 s-hair" x="124.5" y="32.5" width="252" height="238" rx="12"/>
    <text x="139" y="51" class="t-cap">KAGENT 1.0</text>
    <rect class="f-panel s-hair" x="138.5" y="62.5" width="224" height="76" rx="8"/>
    <text x="152" y="87" class="t-name" style="font-size:14px">kagent UI</text>
    <text x="152" y="106" class="t-mono" style="font-size:9.6px">the chat · Approve or Reject</text>
    <line x1="250" y1="139" x2="250" y2="163" style="stroke:var(--muted)" stroke-width="1.3"/>
    <rect class="f-okbg s-ok" x="138.5" y="164.5" width="224" height="94" rx="8"/>
    <text x="152" y="189" class="t-name" style="font-size:14px; fill:var(--ok-deep)">the agent</text>
    <text x="152" y="207" class="t-mono" style="font-size:9.6px">a sandbox for each conversation</text>
    <rect class="f-term" x="152" y="219" width="150" height="23" rx="4"/>
    <text x="162" y="234.5" class="t-m9" style="font-size:9px; fill:var(--term-amber)">holds no credentials</text>
    <rect class="f-panel s-inh" x="0.5" y="56.5" width="94" height="88" rx="9"/>
    <text x="12" y="78" class="t-name" style="font-size:13px">a person</text>
    <circle cx="20" cy="100" r="7" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="20" y="103.1" text-anchor="middle" class="t-m7" style="font-size:8.2px; font-weight:700; fill:var(--panel)">1</text>
    <text x="33" y="103.5" class="t-mono" style="font-size:9.6px; fill:var(--ink)">asks</text>
    <circle cx="20" cy="124" r="7" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="20" y="127.1" text-anchor="middle" class="t-m7" style="font-size:8.2px; font-weight:700; fill:var(--panel)">3</text>
    <text x="33" y="127.5" class="t-mono" style="font-size:9.6px; fill:var(--ink)">approves</text>
    <line class="s-inh" x1="95" y1="100" x2="135" y2="100" stroke-width="1.5" marker-end="url(#kg-inh)"/>
    <line class="s-inh" x1="95" y1="124" x2="135" y2="124" stroke-width="1.5" marker-end="url(#kg-inh)"/>
    <rect class="f-panel2 s-hair" x="388.5" y="32.5" width="271" height="238" rx="12"/>
    <text x="403" y="51" class="t-cap">TURF</text>
    <text x="645" y="51" text-anchor="end" class="t-cap">ON KNATIVE · RESTATE-SERVER</text>
    <rect class="f-panel s-hair" x="402.5" y="62.5" width="243" height="76" rx="8"/>
    <text x="416" y="87" class="t-name" style="font-size:14px">Turf MCP server</text>
    <text x="416" y="106" class="t-mono" style="font-size:9.6px">plan, show, apply: the agent's tools</text>
    <text x="416" y="121" class="t-mono" style="font-size:9.6px">tfstate: a Secret per stack</text>
    <line x1="524" y1="139" x2="524" y2="161" style="stroke:var(--muted)" stroke-width="1.3" marker-end="url(#kg-ink)"/>
    <rect class="f-okbg s-ok" x="402.5" y="164.5" width="243" height="94" rx="8"/>
    <text x="416" y="189" class="t-name" style="font-size:14px; fill:var(--ok-deep)">Turf engine</text>
    <text x="416" y="207" class="t-mono" style="font-size:9.6px">runs the providers · pods from zero</text>
    <rect class="f-term" x="416" y="219" width="168" height="23" rx="4"/>
    <text x="426" y="234.5" class="t-m9 f-termok" style="font-size:9px">holds the cloud credentials</text>
    <path class="f-none s-inh" d="M363,200 H382.5 V100 H399" stroke-width="1.5" marker-end="url(#kg-inh)"/>
    <circle cx="382.5" cy="150" r="7" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="382.5" y="153.1" text-anchor="middle" class="t-m7" style="font-size:8.2px; font-weight:700; fill:var(--panel)">2</text>
    <path class="f-none s-ok" d="M524,259 V306" stroke-width="1.8"/>
    <path class="f-none s-ok" d="M280,306 H593" stroke-width="1.8"/>
    <line class="s-ok" x1="280" y1="306" x2="280" y2="320" stroke-width="1.8" marker-end="url(#kg-ok)"/>
    <line class="s-ok" x1="413" y1="306" x2="413" y2="320" stroke-width="1.8" marker-end="url(#kg-ok)"/>
    <line class="s-ok" x1="593" y1="306" x2="593" y2="320" stroke-width="1.8" marker-end="url(#kg-ok)"/>
    <circle cx="524" cy="293" r="7" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="524" y="296.1" text-anchor="middle" class="t-m7" style="font-size:8.2px; font-weight:700; fill:var(--panel)">4</text>
    <text x="537" y="296.5" class="t-mono" style="font-size:9.6px; fill:var(--ok-deep)">with the credentials</text>
    <line class="s-inh" x1="180" y1="259" x2="180" y2="320" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#kg-inh)"/>
    <circle cx="180" cy="293" r="7" class="f-ink" style="stroke:var(--panel)" stroke-width="1.5"/>
    <text x="180" y="296.1" text-anchor="middle" class="t-m7" style="font-size:8.2px; font-weight:700; fill:var(--panel)">5</text>
    <text x="193" y="296.5" class="t-mono" style="font-size:9.6px; fill:var(--inh)">GETs its public URLs · no credentials</text>
    <text x="0" y="342" class="t-cap">OUTSIDE IT</text>
    <text x="0" y="358" class="t-mono" style="font-size:9.6px">what gets built</text>
    <rect class="f-ok" x="112.5" y="324.5" width="200" height="88" rx="10"/>
    <text x="127" y="349" class="t-name" style="font-size:14px; fill:var(--panel)">cloud resources</text>
    <text x="127" y="367" class="t-mono" style="font-size:9.6px; fill:var(--panel); opacity:.86">two AWS Lambda functions</text>
    <text x="127" y="398" class="t-cap" style="fill:var(--panel); opacity:.72">THE EXAMPLE · A REAL RUN</text>
    <rect class="f-panel s-ok" x="324.5" y="324.5" width="178" height="88" rx="10"/>
    <text x="339" y="349" class="t-name" style="font-size:14px; fill:var(--ok-deep)">Kubernetes clusters</text>
    <text x="339" y="367" class="t-mono" style="font-size:9.6px">EKS, GKE, AKS, bare metal</text>
    <text x="339" y="381" class="t-mono" style="font-size:9.6px">and their addons</text>
    <text x="339" y="398" class="t-cap">IN THE PAPER</text>
    <rect class="f-panel s-faint" x="514.5" y="324.5" width="157" height="88" rx="10" stroke-dasharray="4 3"/>
    <text x="529" y="349" class="t-name" style="font-size:14px">anything with</text>
    <text x="529" y="365" class="t-name" style="font-size:14px">a provider</text>
    <text x="529" y="398" class="t-mono" style="font-size:9.6px">DNS, databases, metal</text>
  </svg>
  {caption && <figcaption class="figcap" set:html={caption} />}
</figure>
