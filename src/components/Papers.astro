---
// The papers band on home (2026-11-07, for KubeCon NA; three papers since 2026-11-16): each paper's
// cover (public/papers/*-cover.jpg, page 1 of the PDF) above a one-paragraph abstract, the page, and
// the Scarf download link tagged ?src=home-papers. The list is data/papers.ts, shared with the index
// at /reference-architectures/, which the band links.
import { papers } from '../data/papers';
---

<section class="band alt" id="papers">
  <div class="wrap">
    <div class="band-head">
      <h2>Three reference architectures.</h2>
      <p>Each one is a PDF to hand to a team: the architecture, a worked example with the agent’s own
        transcripts, and the repository to run it from.</p>
    </div>
    <div class="papers three">
      {papers.map((p) => (
        <article class="paper-card">
          <a class="cover" href={`${p.pdf}?src=home-papers`}>
            <img src={p.cover} alt={p.alt} width="741" height="960" loading="lazy" decoding="async" />
          </a>
          <div>
            <span class="tagline">{p.tagline}</span>
            <h3>{p.title}</h3>
            <p>{p.abstract}</p>
            <p class="links">
              <a href={p.page}>Read the page →</a>
              <a href={`${p.pdf}?src=home-papers`}>Download the PDF →</a>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
