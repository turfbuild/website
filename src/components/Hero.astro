---
// The hero. The headline was reopened on 2026-10-20 (CLAUDE.md, "Locked messaging"). The visual
// beside it is components/StackBuild.astro, CSS only; the CTA row carries no demo link until the
// 1.0 recording exists.
import StackBuild from './StackBuild.astro';
---

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow"><span class="dot"></span> A new infrastructure-as-code engine · built on OpenTofu</p>
      <h1>One tool, from metal to workload, at fleet scale.</h1>
      <p class="lede">Turf™ is a new engine for infrastructure as code. Describe the whole stack in the
        Terraform® language — hosts, clusters, charts, playbooks, the workload — and plan every
        operation the same way: resources and actions, converged in rounds, in one run. Agents oversee
        it from Claude Code, Cursor, Codex or any MCP client. Every change is
        <strong>planned, visible, and approved</strong> before it happens.
        <strong>Nothing runs off-plan.</strong></p>
      <div class="cta-row">
        <a class="btn primary" href="/get-started/">Try Turf free</a>
        <a class="btn ghost" href="/use-cases/">Use cases</a>
        <a class="btn ghost" href="/licensing/#pilot">Pilot program</a>
      </div>
      <div class="install"><span class="ps1">$</span> brew install restatedev/tap/restate-server turfbuild/tap/turf</div>
      <div class="trust">
        <span class="chip mcp"><span class="sw"></span>Claude Code, Cursor, Codex &amp; any MCP client</span>
        <span class="chip tf"><span class="sw"></span>Terraform HCL &amp; modules</span>
        <span class="chip otf"><span class="sw"></span>OpenTofu providers</span>
        <span class="chip"><span class="sw"></span>Local AI models and GPU clouds</span>
      </div>
    </div>
    <div>
      <StackBuild />
      <p class="pp-caption">the whole stack in one configuration — planned, approved and applied round by round</p>
    </div>
  </div>
</header>
