---
// The pilot-program band at the foot of home. Its sentences are /licensing/'s: change that page
// first. `alt` by default, as /use-cases/ needs it; home passes `alt={false}` since the drift band
// joined (the papers band before it is `alt` there). The .partner block paints its own background
// either way.
interface Props {
  alt?: boolean;
}
const { alt = true } = Astro.props;
---

<section class:list={['band', { alt }]}>
  <div class="wrap">
    <div class="partner">
      <div>
        <h2>Evaluating Turf at a larger organization?</h2>
        <p class="mt">Turf is free for individuals, education and small businesses within the
        Community limits. Government and larger organizations need a commercial license, and any
        organization can evaluate Turf in non-production for 30 days with nothing to sign. For a
        longer or supported trial there is a free 60-day pilot on a standard contract you can read
        in full: <b>the same binary</b> everyone downloads, <b>a direct support channel</b> for the
        pilot, and <b>no license key</b>. The teams that pilot early shape what comes next.</p>
      </div>
      <div class="side">
        <a class="btn primary" href="mailto:licensing@turf.build?subject=Pilot">Start a pilot</a>
        <span class="mail">or read the terms at <a href="/licensing/">turf.build/licensing</a></span>
      </div>
    </div>
  </div>
</section>
