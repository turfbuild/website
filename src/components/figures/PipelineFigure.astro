---
// Figure 1 of Pull Request to Production, ported: the pipeline with an agent in it. Eight stops
// along one lane (open · plan · comment · review · merge · apply · verify · promote), the reviewed
// plan tied to the apply by its digest, and below the lane the runner: the agent in gh-aw's
// sandbox, Turf's server and engine beside it on the host, and the GitHub Environment feeding
// the variables, the role and the rule's name. Markers come from FigureDefs.
const stops = [
  { x: 42, name: 'open', desc: ['a pull request'] },
  { x: 126, name: 'plan', desc: ['providers scanned,', 'the plan judged', 'by the rule'] },
  { x: 210, name: 'comment', desc: ['the plan, the', 'verdict, the rule'] },
  { x: 294, name: 'review', desc: ["the agent's review;", 'a person merges'] },
  { x: 378, name: 'merge', desc: ['a push to main'] },
  { x: 462, name: 'apply', desc: ['the reviewed plan,', 'approved by its', 'digest, under the rule'] },
  { x: 546, name: 'verify', desc: ['the agent, inside', 'the apply'] },
  { x: 630, name: 'promote', desc: ['production, under', 'a stricter rule'] },
];
---

<svg class="fig" viewBox="0 0 672 300" role="img" aria-label="The pipeline with an agent in it: open, plan, comment, review, merge, apply, verify, promote, with the reviewed plan tied to the apply by its digest. Below the lane, the runner: the agent in a sandbox, Turf's server and engine on the host beside it, and the GitHub Environment feeding the variables, the role and the rule's name.">
  <text x="0" y="14" class="t-cap">PULL REQUEST TO PRODUCTION · EVERY STOP ATTENDED</text>
  <line x1="42" y1="64" x2="630" y2="64" class="s-ok" stroke-width="2"/>
  <path d="M126,64 Q126,36 160,36 H428 Q462,36 462,64" fill="none" class="s-ok" stroke-width="1.6"/>
  <rect x="258" y="28" width="72" height="16" rx="8" class="f-panel s-ok"/>
  <text x="294" y="39.5" text-anchor="middle" class="t-mono" style="fill:var(--ok); font-size:7.6px">by digest</text>
  {stops.map((s) => (
    <g>
      <circle cx={s.x} cy="64" r="7" class="f-ok"/>
      <text x={s.x} y="84" text-anchor="middle" class="t-bold" style="font-size:10.5px">{s.name}</text>
      {s.desc.map((line, i) => (
        <text x={s.x} y={97 + i * 10} text-anchor="middle" class="t-sans" style="font-size:8px; fill:var(--muted)">{line}</text>
      ))}
    </g>
  ))}

  <!-- the runner -->
  <rect x="0.5" y="146.5" width="671" height="128" rx="12" class="f-panel s-hair" stroke-dasharray="4 3"/>
  <text x="14" y="164" class="t-cap">THE GITHUB ACTIONS RUNNER · ONE JOB PER STOP</text>
  <rect x="14" y="174" width="236" height="90" rx="10" class="f-inhbg s-inh" stroke-width="1.2"/>
  <text x="26" y="192" class="t-title">The agent, in a sandbox</text>
  <text x="26" y="206" class="t-mono" style="fill:var(--inh)">GitHub Agentic Workflows · Claude</text>
  <text x="26" y="222" class="t-sans">a firewall, a tool allowlist, a read-only token</text>
  <text x="26" y="236" class="t-sans">no cloud credentials; the rules as files</text>
  <text x="26" y="254" class="t-mono">init · open · up · show · apply · output</text>
  <line x1="250" y1="208" x2="282" y2="208" class="s-ok" stroke-width="1.6" marker-end="url(#a-ok)"/>
  <text x="266" y="200" text-anchor="middle" class="t-mono" style="fill:var(--ok); font-size:7.2px">MCP</text>
  <rect x="284" y="174" width="206" height="90" rx="10" class="f-ground s-hair"/>
  <text x="296" y="192" class="t-title">Turf, on the host</text>
  <rect x="296" y="200" width="182" height="17" rx="5" class="f-ok"/>
  <text x="304" y="212" class="t-mono" style="fill:#fff">turf-mcp-server · http :3000/mcp</text>
  <rect x="296" y="221" width="182" height="17" rx="5" class="f-ink"/>
  <text x="304" y="233" class="t-mono" style="fill:var(--term-ink)">the Turf engine · providers</text>
  <rect x="296" y="242" width="182" height="17" rx="5" class="f-host"/>
  <text x="304" y="254" class="t-mono" style="fill:var(--term-ink)">restate-server · durable record</text>
  <rect x="504" y="174" width="154" height="90" rx="10" class="f-panel s-inh" stroke-width="1.2"/>
  <text x="516" y="192" class="t-title">GitHub Environment</text>
  <text x="516" y="206" class="t-mono" style="fill:var(--inh)">staging · production</text>
  <text x="516" y="222" class="t-sans">TF_VAR_* · the state key</text>
  <text x="516" y="236" class="t-sans">the AWS role, minted by OIDC</text>
  <text x="516" y="250" class="t-sans">the rule's name</text>
  <line x1="504" y1="230" x2="492" y2="230" class="s-inh" stroke-width="1.4" marker-end="url(#a-inh)"/>
  <!-- the lane runs on the runner -->
  <line x1="126" y1="120" x2="126" y2="146" class="s-faint" stroke-width="1.2" stroke-dasharray="3 3"/>
  <line x1="462" y1="120" x2="462" y2="146" class="s-faint" stroke-width="1.2" stroke-dasharray="3 3"/>
  <line x1="630" y1="110" x2="630" y2="146" class="s-faint" stroke-width="1.2" stroke-dasharray="3 3"/>
  <text x="664" y="292" text-anchor="end" class="t-cap">EACH STOP IS A RUN · THE RECORD IS THE PULL REQUEST</text>
</svg>
