  <text x="74.5" y="120" text-anchor="middle" class="t-m7 f-muted">a hint · costs nothing</text>
  <line x1="74.5" y1="131" x2="74.5" y2="144" class="s-stroke" stroke-width="1.2" marker-end="url(#a-ink)"/>

  <rect x="10.5" y="146.5" width="128" height="48" rx="8" class="f-panel s-hair"/>
  <text x="74.5" y="164" text-anchor="middle" class="t-name">read</text>
  <text x="74.5" y="176" text-anchor="middle" class="t-m7 f-muted">one provider read</text>
  <text x="74.5" y="186" text-anchor="middle" class="t-m7 f-muted">then classified</text>
  <line x1="74.5" y1="195" x2="74.5" y2="212" class="s-stroke" stroke-width="1.2" marker-end="url(#a-ink)"/>

  <!-- noise drops out after the read, before the notice -->
  <line x1="139" y1="170.5" x2="148" y2="170.5" class="s-stroke" stroke-width="1" stroke-dasharray="3 2.5" marker-end="url(#a-ink)"/>
  <rect x="150.5" y="146.5" width="124" height="72" rx="8" class="f-none s-faint" stroke-dasharray="4 3"/>
  <text x="157" y="162" class="t-cap">NOISE · WAKES NOBODY</text>
  {noiseNarrow.map((n, i) => <text x="158" y={176 + i * 11} class="t-m7 f-muted">{n}</text>)}

  <rect x="10.5" y="214.5" width="128" height="48" rx="8" class="f-partbg s-part"/>
  <text x="74.5" y="232" text-anchor="middle" class="t-name f-part">drift notice</text>
  <text x="74.5" y="244" text-anchor="middle" class="t-m7 f-part">address · class</text>
  <text x="74.5" y="254" text-anchor="middle" class="t-m7 f-part">paths, never values</text>

  <!-- the agent: which side wins -->
  <line x1="74.5" y1="263" x2="74.5" y2="296" class="s-inh" stroke-width="1.3" marker-end="url(#a-inh)"/>
  <text x="84" y="277" class="t-m7 f-inh">watch · status</text>
  <text x="84" y="287" class="t-m7 f-inh">the console · a webhook</text>
  <rect x="10.5" y="298.5" width="128" height="48" rx="8" class="f-inhbg s-inh"/>
  <text x="74.5" y="316" text-anchor="middle" class="t-name f-inh">your agent</text>
  <text x="74.5" y="328" text-anchor="middle" class="t-m7 f-inh">decides which</text>
  <text x="74.5" y="338" text-anchor="middle" class="t-m7 f-inh">side wins</text>
  <line x1="139" y1="322.5" x2="150" y2="322.5" class="s-inh" stroke-width="1"/>
