  <!-- the plan still governs -->
  <line x1="74.5" y1="347" x2="74.5" y2="360" class="s-inh" stroke-width="1.3" marker-end="url(#a-inh)"/>
  <rect x="10.5" y="362.5" width="128" height="48" rx="8" class="f-okbg s-ok"/>
  <text x="74.5" y="380" text-anchor="middle" class="t-name f-okdeep">plan</text>
  <text x="74.5" y="392" text-anchor="middle" class="t-m7 f-okdeep">reads only</text>
  <text x="74.5" y="402" text-anchor="middle" class="t-m7 f-okdeep">what drifted</text>
  <line x1="139" y1="377.5" x2="150" y2="377.5" class="s-ok" stroke-width="1"/>
  <rect x="150.5" y="370.5" width="96" height="14" rx="7" class="f-ok s-ok"/>
  <text x="198.5" y="380.5" text-anchor="middle" class="t-m7 f-panel" style="font-weight:700">approval point</text>
  <line x1="198.5" y1="385" x2="198.5" y2="390" class="s-ok" stroke-width="1"/>
  <rect x="150.5" y="390.5" width="96" height="14" rx="7" class="f-panel s-ok"/>
  <text x="198.5" y="400.5" text-anchor="middle" class="t-m7 f-okdeep" style="font-weight:700">apply</text>
  <text x="198.5" y="418" text-anchor="middle" class="t-m7 f-okdeep">the notice clears</text>
</svg>
