---
// Figure 9 of Metal to Tokens, ported: a tenant order in the data center. The control plane
// writes a tenant's cluster as HCL, which goes through pull request, review and merge into a data
// center where Turf runs beside six racks of tenant clusters; the control plane also calls Turf's
// MCP server and reads the outputs back. The paper fills the racks with a script at load; here
// the same generator runs in the frontmatter, so the page ships no JS.
type Unit = { x: number; y: number; w: number; h: number; cls: string };
const ramp = ['f-hair', 'f-faint', 'f-cluster'];
const racks = [[5, 4, 4, 4], [3, 6, 4, 4], [6, 5, 6], [4, 4, 5, 4], [5, 3, 5, 4], [6, 6, 5]];
const live = new Set(['0-1', '2-2', '3-0', '5-1']);
const x0 = 342, w = 44, step = 54, top = 64, h = 190, uh = 6.4, ug = 2.2, gap = 4.5;
const frames: { x: number; cx: number; label: string }[] = [];
const units: Unit[] = [];
racks.forEach((groups, r) => {
  const x = x0 + r * step;
  let y = top + 5;
  frames.push({ x, cx: x + w / 2, label: `RACK ${r + 1}` });
  const unit = (cls: string) => {
    units.push({ x: x + 5, y: Number(y.toFixed(1)), w: w - 10, h: uh, cls });
    y += uh + ug;
  };
  unit('f-ink');
  groups.forEach((n, k) => {
    y += gap;
    for (let b = 0; b < n; b++) unit(live.has(`${r}-${k}`) ? 'f-ok' : ramp[(r + k) % ramp.length]);
  });
});
---

