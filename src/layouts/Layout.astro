---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of the index (404). Also suppresses canonical/og:url —
   *  a self-canonical pointing at a route that doesn't exist is worse than none. */
  noindex?: boolean;
  /** schema.org node, or array of nodes, rendered as JSON-LD in <head>. */
  jsonLd?: unknown;
}

const {
  title = 'Turf — The infrastructure engine built for AI agents',
  description = 'Turf is the AI-native infrastructure engine: Terraform-compatible infrastructure as code, driven by AI agents over MCP. Every change is planned and approved.',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt =
  'Turf — the Terraform-compatible infrastructure engine for AI agents, governed by the plan.';
const schemas = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Analytics tags are injected by CookieConsent.astro, after consent. -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph / Twitter. Dimensions and type are declared so scrapers that
         won't fetch the image still render a full-bleed card. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Turf" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schemas.map((schema) => <JsonLd schema={schema} />)}
  </head>
  <body>
    <TopNav />
    <slot />
    <Footer />
    <CookieConsent />
  </body>
</html>
