---
import Layout from '../layouts/Layout.astro';
const title = 'Turf — Contact';
const description = 'Talk to the Turf team — design-partner inquiries, commercial licensing, and security reports.';
---

<Layout title={title} description={description}>
  <section class="subhero">
    <div class="wrap">
      <p class="eyebrow"><span class="dot"></span> Contact</p>
      <h1>Talk to us.</h1>
      <p class="lede">We’re a small team building Turf in the open. The fastest way to reach us is
        email — we read every message.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>General</h2>
      <p>Questions, feedback, or just want to compare notes on governing infrastructure AI?
        Write to <a href="mailto:contact@turf.build">contact@turf.build</a>.</p>

      <h2>Design partners</h2>
      <p>We’re looking for teams working on layered infrastructure, policy gates, and AI under real
        governance constraints. Design partners get white-glove onboarding, direct roadmap influence,
        and discounted commercial terms while we build together.
        <a href="mailto:contact@turf.build?subject=Design%20partner">Start the conversation →</a></p>

      <h2>Commercial licensing</h2>
      <p>Planning to run Turf in production? Commercial licensing is coming — tell us about your use
        case at <a href="mailto:contact@turf.build?subject=Commercial">contact@turf.build</a>.</p>

      <h2>Security</h2>
      <p>Found a vulnerability? Please report it privately to
        <a href="mailto:security@turf.build">security@turf.build</a> rather than opening a public issue.</p>

      <h2>Stay in the loop</h2>
      <p>Release notes, new capabilities, and design-partner openings — subscribe from the footer of
        any page.</p>
    </div>
  </section>
</Layout>
