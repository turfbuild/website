---
import Layout from '../layouts/Layout.astro';
import FigureDefs from '../components/FigureDefs.astro';
import Hero from '../components/Hero.astro';
import WhyEngine from '../components/WhyEngine.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ActionsInPlan from '../components/ActionsInPlan.astro';
import AgentInLoop from '../components/AgentInLoop.astro';
import CompatibilityTeaser from '../components/CompatibilityTeaser.astro';
import OpsEnvironment from '../components/OpsEnvironment.astro';
import Engine from '../components/Engine.astro';
import UseCasesTeaser from '../components/UseCasesTeaser.astro';
import Flexibility from '../components/Flexibility.astro';
import Partner from '../components/Partner.astro';
import Announcement from '../components/Announcement.astro';

const site = 'https://turf.build';

// Organization + WebSite + SoftwareApplication. The nodes cross-reference by @id
// so crawlers read them as one graph rather than three unrelated entities.
//
// SoftwareApplication deliberately carries NO `offers` node: a price of 0 would
// assert the product is free for everyone, when commercial use is licensed
// (/pricing/, /licensing/). Its `license` points at /licensing/ instead. Don't
// "fix" this by adding an offer.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: 'Turf',
    url: `${site}/`,
    logo: `${site}/logo.png`,
    description:
      'Turf builds a new engine for infrastructure as code: Terraform-compatible, built on OpenTofu, driven by AI agents over MCP, planning the whole stack in one run.',
    sameAs: [
      'https://github.com/turfbuild',
      'https://www.linkedin.com/company/turfbuild/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: 'Turf',
    url: `${site}/`,
    publisher: { '@id': `${site}/#organization` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${site}/#software`,
    name: 'Turf',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'Infrastructure as code',
    operatingSystem: 'macOS, Linux',
    url: `${site}/`,
    downloadUrl: `${site}/get-started/`,
    softwareHelp: `${site}/docs/`,
    license: `${site}/licensing/`,
    softwareVersion: '1.0.0',
    releaseNotes: `${site}/engine/`,
    description:
      'Turf is a new engine for infrastructure as code, built on OpenTofu and exposed to AI agents as an MCP server. It plans the whole stack as standard Terraform, resources and actions in one plan, and converges it in rounds; every change is a Terraform plan, approved before it runs.',
    featureList: [
      'Every change is a Terraform plan, approved before it runs',
      'Multi-round convergence of layered stacks in one run',
      'Terraform actions with lifecycle triggers and overlays',
      'Turf actions: checks, questions and notifications as steps of the apply',
      'Durable runs on Restate; provider calls that scale out',
      'State encryption at rest; OpenTelemetry built in',
      'MCP server for Claude, Codex, Gemini, and any MCP client',
      'Standard Terraform: HCL, registry modules and OpenTofu providers',
    ],
    publisher: { '@id': `${site}/#organization` },
  },
];
---

<Layout jsonLd={jsonLd}>
  <Announcement slot="banner" />
  <FigureDefs />
  <Hero />
  <WhyEngine />
  <HowItWorks />
  <ActionsInPlan />
  <AgentInLoop />
  <CompatibilityTeaser />
  <OpsEnvironment />
  <Engine />
  <UseCasesTeaser />
  <Flexibility />
  <Partner />
</Layout>
