---
import Layout from '../layouts/Layout.astro';
import { papers } from '../data/papers';
// The index of papers (2026-11-16, with the third paper). Until then this URL was *Metal to Tokens*'
// own page, which now lives at /reference-architectures/metal-to-tokens/; links shared to the old
// URL land here, one click from the paper. The list is data/papers.ts, shared with the home band.
// Download links carry ?src=papers-index. See "Papers" in CLAUDE.md.
const title = 'Turf — Reference architectures: GPU clouds, CI/CD, kagent';
const description =
  'Three Turf reference architectures, each a PDF: Metal to Tokens for GPU clouds, Pull Request to Production for Terraform CI/CD, and one for agents on kagent.';

const site = 'https://turf.build';
const publisher = { '@type': 'Organization', '@id': `${site}/#organization`, name: 'Turf' };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${site}/reference-architectures/#papers`,
    name: 'Turf reference architectures',
    description,
    url: `${site}/reference-architectures/`,
    inLanguage: 'en-US',
    publisher: publisher,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: papers.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: `${site}${p.page}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Turf', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Reference architectures' },
    ],
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="subhero">
    <div class="wrap">
      <p class="eyebrow"><span class="dot"></span> Papers</p>
      <h1>Reference architectures.</h1>
      <p class="lede">Three papers on Turf™, for GPU clouds, for Terraform® in CI/CD, and for agents on
        Kubernetes®. Each is a PDF to hand to a team: the architecture, a worked example with the
        agent’s own transcripts, and the repository to run it from.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="papers list">
        {papers.map((p) => (
          <article class="paper-card" id={p.id}>
            <a class="cover" href={p.page}>
              <img src={p.cover} alt={p.alt} width="741" height="960" loading="lazy" decoding="async" />
            </a>
            <div>
              <span class="tagline">{p.tagline}</span>
              <h2>{p.title}</h2>
              <p>{p.abstract}</p>
              <p class="links">
                <a href={p.page}>Read the page →</a>
                <a href={`${p.pdf}?src=papers-index`}>Download the PDF →</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      <h2>Get Turf: download it, run it.</h2>
      <p>Turf is available now, as a download. No form, no login. Free for noncommercial use.
        Commercial use, including a company’s internal use, requires a license; companies evaluate
        Turf under a free pilot. Each paper’s example is a public repository, listed on
        <a href="/demo/">the demos page</a>.</p>
      <p class="ctas">
        <a class="btn primary" href="/get-started/">Get started</a>
        <a class="btn ghost" href="/demo/">Demos and examples</a>
        <a class="btn ghost" href="/licensing/">Licensing</a>
      </p>
      <p class="legal-note">NVIDIA and NVCRE are trademarks or product names of NVIDIA Corporation. GitHub
        and GitHub Agentic Workflows are trademarks of GitHub, Inc. Terraform is a registered trademark of HashiCorp, Inc.
        Kubernetes is a registered trademark of the Linux Foundation. kagent is a Cloud Native Computing
        Foundation project. Each is named here only to describe interoperability. Turf is not affiliated
        with, endorsed by, or sponsored by any of them. All other marks belong to their owners.</p>
    </div>
  </section>
</Layout>

<style>
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .legal-note {
    margin-top: clamp(28px, 4vw, 44px); padding-top: 18px; border-top: 1px solid var(--hair);
    max-width: 92ch; color: var(--faint); font-size: 12.5px; line-height: 1.6;
  }
</style>
