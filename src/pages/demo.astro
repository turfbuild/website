---
// The demos hub (2026-11-07; until then this page was the kind-CRD recording alone). Three public
// examples to run, each with its visual — the AICR console still, the kagent figure, the pipeline
// figure — from data/examples.ts, shared with the home band; then the two recordings from before
// 1.0: the kind-CRD stack up and down (kept here with its round-annotated HCL) and the Scalr take at
// /demo/scalr/, which the KubeCon playbook shows on a phone, so its URL does not move.
import Layout from '../layouts/Layout.astro';
import FigureDefs from '../components/FigureDefs.astro';
import Still from '../components/Still.astro';
import KagentFigure from '../components/figures/KagentFigure.astro';
import PipelineFigure from '../components/figures/PipelineFigure.astro';
import { examples } from '../data/examples';

const [aicr, kagent, ghaw] = examples;
const title = 'Turf — Demos: three examples to run, and two recordings';
const description =
  'Run Turf yourself: the AI Cluster Runtime stack on kind, an agent in the cluster with kagent, and a pull request that applies itself. Plus two recordings.';
const exampleUrl =
  'https://github.com/turfbuild/turf-examples/tree/main/terraform/kubernetes/kind-crd';

// VideoObject per screencast. `uploadDate` is the date the asset landed in git and
// `duration` comes from ffprobe — re-derive both if the recordings are replaced:
//   git log --diff-filter=A --format=%aI -1 -- public/demos/<name>.mp4
//   ffprobe -v error -show_entries format=duration -of csv=p=0 public/demos/<name>.mp4
// Keep the whole %aI string, offset and all: Google rejects a date-only `uploadDate` as
// missing a timezone, and the demo pages are the site's only VideoObject nodes.
const site = 'https://turf.build';
// Inlined rather than an `@id` reference to the home page's Organization node —
// a cross-page @id doesn't resolve, so the publisher would read as an empty node.
const publisher = { '@type': 'Organization', '@id': `${site}/#organization`, name: 'Turf' };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Turf converges a Kubernetes stack in one turf up',
    description:
      'A kind cluster, a CustomResourceDefinition, and an instance of it — three resources that each depend on the previous one existing. Turf plans them across rounds and converges all three in a single governed run.',
    thumbnailUrl: `${site}/demos/kind-crd-up-poster.png`,
    contentUrl: `${site}/demos/kind-crd-up.mp4`,
    encodingFormat: 'video/mp4',
    duration: 'PT34S',
    uploadDate: '2026-08-06T14:18:18-07:00',
    publisher: publisher,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Turf tears the stack down with turf destroy',
    description:
      'Reverse-dependency teardown of the same Kubernetes stack: custom resource, then CustomResourceDefinition, then the kind cluster — planned and approved before anything is removed.',
    thumbnailUrl: `${site}/demos/kind-crd-destroy-poster.png`,
    contentUrl: `${site}/demos/kind-crd-destroy.mp4`,
    encodingFormat: 'video/mp4',
    duration: 'PT20S',
    uploadDate: '2026-08-06T14:18:18-07:00',
    publisher: publisher,
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <FigureDefs />
  <section class="subhero">
    <div class="wrap">
      <p class="eyebrow"><span class="dot"></span> Demos · three examples and two recordings</p>
      <h1>See Turf running.</h1>
      <p class="lede">Three public repositories, each a README away from a run: a GPU cloud’s runtime on a
        Kubernetes® cluster in Docker, seventeen Helm® releases from one recipe; an agent that lives in
        the cluster it manages; and a pipeline where an agent attends every Terraform® apply. Then two
        recordings from before 1.0. <strong>Turf™ plans, approves and applies each of them the same
        way, round by round.</strong></p>
    </div>
  </section>

  <section class="section" id="examples">
    <div class="wrap">
      <div class="band-head">
        <h2>Three things you can run today.</h2>
        <p>The first two run on kind, on a laptop with Docker; the third runs in your GitHub organization.</p>
      </div>

      <div class="feature center" id={aicr.id}>
        <div>
          <Still id="aicr-certify" src="/console/aicr-round2-certify-action.png"
            alt="The Turf console: round 2 of a run is applying, paused at the certify action, with a lane for every Helm release of the runtime."
            caption="The Turf console: the AI Cluster Runtime stack applying in round 2, paused at the certify step. Click to enlarge." />
        </div>
        <div>
          <p class="eyebrow"><span class="dot"></span> {aicr.tagline}</p>
          <h3>{aicr.title}</h3>
          {aicr.body.map((para) => <p>{para}</p>)}
          <p class="links">{aicr.links.map((l) => <a href={l.href}>{l.label} →</a>)}</p>
        </div>
      </div>

      <div class="feature center fig-lg-r" id={kagent.id}>
        <div>
          <p class="eyebrow"><span class="dot"></span> {kagent.tagline}</p>
          <h3>{kagent.title}</h3>
          {kagent.body.map((para) => <p>{para}</p>)}
          <p class="links">{kagent.links.map((l) => <a href={l.href}>{l.label} →</a>)}</p>
        </div>
        <div>
          <KagentFigure />
          <p class="figcap"><b>The agent in the cluster.</b> A person approves in the kagent UI; the agent
            calls Turf through the egress gateway, which adds the token; the engine runs only while there
            is work; the state never leaves the cluster.</p>
        </div>
      </div>

      <div class="feature center fig-lg" id={ghaw.id}>
        <div>
          <PipelineFigure />
          <p class="figcap"><b>Every stop attended.</b> Open, plan, comment, review, merge, apply, verify,
            promote: the reviewed plan is tied to the apply by its digest, and the agent runs in the
            workflow’s sandbox beside Turf on the runner.</p>
        </div>
        <div>
          <p class="eyebrow"><span class="dot"></span> {ghaw.tagline}</p>
          <h3>{ghaw.title}</h3>
          {ghaw.body.map((para) => <p>{para}</p>)}
          <p class="links">{ghaw.links.map((l) => <a href={l.href}>{l.label} →</a>)}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" id="recordings">
    <div class="wrap">
      <div class="band-head">
        <h2>Two recordings, from before 1.0.</h2>
        <p>A Kubernetes stack up and down in one <code>turf up</code>, and Scalr as the control plane with
          Turf as the engine. Recorded on a pre-1.0 build; the loop is the same.</p>
      </div>

      <figure class="demo-figure">
        <video
          class="demo-video"
          controls
          muted
          playsinline
          preload="metadata"
          poster="/demos/kind-crd-up-poster.png"
        >
          <source src="/demos/kind-crd-up.webm" type="video/webm" />
          <source src="/demos/kind-crd-up.mp4" type="video/mp4" />
          Your browser can't play this video —
          <a href="/demos/kind-crd-up.mp4">download the MP4</a>.
        </video>
        <figcaption class="demo-cap">
          <code class="mono">turf up</code> — cluster → CRD → custom resource, converged in one run.
        </figcaption>
      </figure>

      <div class="prose demo-config-head">
        <h3>One config. Three rounds.</h3>
        <p>The whole demo is a single Terraform file: a kind cluster, a <code>CustomResourceDefinition</code>,
          and an instance of it, three resources that each depend on the previous one existing. Turf
          converges it in three planned, approved rounds, configuring the kubernetes provider in round 2
          once the cluster's endpoint is known. The round labels below are exactly what
          <code class="mono">turf up</code> computes; nothing is edited or staged by hand.</p>
      </div>

      <div class="codeblock rounds">
        <div class="cb-head">
          <span>main.tf</span>
          <span class="cb-legend"><span class="mk">+</span> create · each round planned &amp; approved</span>
        </div>
        <div class="rounds-body">
          <div class="round round-1">
            <div class="round-tag">
              <span class="round-name">Round 1 · create</span>
              <span class="round-eff"><span class="mk">+</span> kind_cluster.demo</span>
            </div>
<pre><span class="cm"># A local Kubernetes cluster running as Docker containers via kind.</span>
<span class="kw">resource</span> <span class="str">"kind_cluster"</span> <span class="str">"demo"</span> &#123;
  name           = var.cluster_name
  node_image     = var.node_image
  wait_for_ready = true
&#125;</pre>
          </div>

          <div class="round round-2">
            <div class="round-tag">
              <span class="round-name">Round 2 · create</span>
              <span class="round-eff"><span class="mk">+</span> kubernetes_manifest.crd</span>
            </div>
<pre><span class="cm"># The kubernetes provider binds to the cluster's computed endpoint — unknown</span>
<span class="cm"># until round 1 applied. Turf configures it here, then reloads it so the new</span>
<span class="cm"># CRD's API is discoverable.</span>
<span class="kw">provider</span> <span class="str">"kubernetes"</span> &#123;
  host                   = kind_cluster.demo.endpoint
  client_certificate     = kind_cluster.demo.client_certificate
  client_key             = kind_cluster.demo.client_key
  cluster_ca_certificate = kind_cluster.demo.cluster_ca_certificate
&#125;

<span class="cm"># Registers a new API kind, demo.local/v1 "Turf".</span>
<span class="kw">resource</span> <span class="str">"kubernetes_manifest"</span> <span class="str">"crd"</span> &#123;
  manifest = &#123; <span class="cm"># … CustomResourceDefinition for turfs.demo.local (elided) …</span> &#125;
&#125;</pre>
          </div>

          <div class="round round-3">
            <div class="round-tag">
              <span class="round-name">Round 3 · create</span>
              <span class="round-eff"><span class="mk">+</span> kubernetes_manifest.instance</span>
            </div>
<pre><span class="cm"># The "Turf" kind does not exist until the CRD applies, so this cannot be</span>
<span class="cm"># planned until round 2 is live. depends_on orders it; Turf defers it here.</span>
<span class="kw">resource</span> <span class="str">"kubernetes_manifest"</span> <span class="str">"instance"</span> &#123;
  <span class="kw">depends_on</span> = [kubernetes_manifest.crd]
  manifest   = &#123;
    apiVersion = <span class="str">"demo.local/v1"</span>
    kind       = <span class="str">"Turf"</span>
    metadata   = &#123; name = <span class="str">"example-turf"</span> &#125;
    spec       = &#123; message = var.cr_message &#125;
  &#125;
&#125;</pre>
          </div>
        </div>
      </div>

      <figure class="demo-figure demo-figure-after">
        <video
          class="demo-video"
          controls
          muted
          playsinline
          preload="metadata"
          poster="/demos/kind-crd-destroy-poster.png"
        >
          <source src="/demos/kind-crd-destroy.webm" type="video/webm" />
          <source src="/demos/kind-crd-destroy.mp4" type="video/mp4" />
          Your browser can't play this video —
          <a href="/demos/kind-crd-destroy.mp4">download the MP4</a>.
        </video>
        <figcaption class="demo-cap">
          <code class="mono">turf destroy</code> — reverse-dependency teardown: custom resource → CRD →
          cluster, planned and approved before anything is removed.
        </figcaption>
      </figure>

      <div class="prose demo-config-foot">
        <p>No <code>-target</code>, no staged applies, no edits to your <code>.tf</code>: the deferral
          loop converges the file as-is, and tears it down the same way. No cloud account or credentials
          required; kind runs the cluster as local Docker containers. The second recording puts Scalr in
          front of the engine: remote state, workspace variables and an OPA policy group over MCP, and a
          plan that violates the group’s policy, caught before it runs.</p>
        <p class="demo-ctas">
          <a class="btn primary" href="/demo/scalr/">The Scalr recording →</a>
          <a class="btn ghost" href={exampleUrl}>This stack on GitHub →</a>
          <a class="btn ghost" href="/get-started/">Install Turf →</a>
        </p>
      </div>

      <p class="legal-note">NVIDIA and AI Cluster Runtime are trademarks or product names of NVIDIA Corporation.
        kagent, gVisor and Knative are trademarks or project names of their respective owners. GitHub and
        GitHub Agentic Workflows are trademarks of GitHub, Inc. Amazon Web Services, AWS and AWS Lambda are
        trademarks of Amazon.com, Inc. or its affiliates. Scalr is a trademark of Scalr, Inc. Each is named
        here only to describe interoperability. Turf is not affiliated with, endorsed by, or sponsored by
        any of them. All other marks belong to their owners.</p>
    </div>
  </section>
</Layout>

<style>
  .demo-figure {
    margin: 0 0 clamp(20px, 3vw, 32px);
  }
  .demo-figure-after {
    margin-top: clamp(20px, 3vw, 32px);
  }
  .demo-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--shadow);
    border: 1px solid var(--hair-strong);
    background: var(--term-bg);
  }
  .demo-cap {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }
  .demo-cap code {
    font-size: 12.5px;
  }
  .demo-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  /* The example rows reuse .feature; their link rows match the home cards' .links. */
  .feature .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 4px 0 0;
  }
  .feature .links a {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ok-deep);
  }

  /* The round-annotated HCL panel is global: .codeblock.rounds / .round in global.css. */
  .demo-config-head {
    margin-bottom: clamp(18px, 2.5vw, 26px);
  }
  .demo-config-foot {
    margin-top: clamp(18px, 2.5vw, 26px);
  }
</style>
