{
  "name": "turf-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "turf.build product marketing site",
  "scripts": {
    "dev": "astro dev",
    "dev:docs": "npm --prefix docs run dev",
    "build": "astro build && npm --prefix docs run build && node scripts/merge-docs.mjs",
    "preview": "astro preview",
    "check": "astro check && npm --prefix docs run check",
    "postinstall": "npm --prefix docs install --no-audit --no-fund"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
